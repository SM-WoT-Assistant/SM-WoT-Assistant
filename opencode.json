{
  "$schema": "https://opencode.ai",
  "lsp": true,
  "plugin": [
    "@cortexkit/opencode-magic-context@latest"
  ],
  "compaction": {
    "auto": false,
    "prune": false,
    "snapshots": false
  },
  "permissions": {
    "edit": [{"pattern": "*", "action": "allow"}],
    "write": [{"pattern": "*", "action": "allow"}]
  }
}
