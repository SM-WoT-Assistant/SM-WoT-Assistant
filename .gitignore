# Python
__pycache__/
*.py[cod]
*$py.class
.venv/
.venv-1/
.venv-2/
venv/
*.egg-info/
.eggs/

# Локальні / великі дані (за потреби приберіть рядок, якщо хочете версіонувати)
extracted_maps/
extracted_data/
extracted_icons/
extracted_gui/
*.rar

# Тимчасові файли і папки
tmp/
*.log
build_test.log
startup.log

# Маніфести витягнення (генеруються автоматично)
.icon_extract_manifest.json
.tank_extract_manifest.json

# AI-кеш (великий, генерується автоматично)
ai_cache.json
ai_builds_cache.json

# Службові повідомлення (невидимі для користувача)
service_messages.json

# Прогрес заповнення кешу
_fill_progress.json
fill_log.txt
prompt_*.txt

# Backup-файли (генеруються при помилках)
*.broken_fallback_backup.json

# Runtime артефакти вбудованого браузера (cache/history/logs)
browser_profile/

# Автоматично згенеровані дані з клієнта гри
tank_db.json
tank_tth.json

# Налаштування користувача (генеруються при першому запуску)
settings.json

# Локалізація (оновлюється автоматично)
locales.json

# Кеш популярних танків (AI)
popular_tanks_cache.json

# Збірки обладнання/екіпажу (оновлюються авто-апдейтером)
crew_builds.json

# Архів старих файлів
_archive/

# opencode worktree tracking
.kilo/

# opencode historian session data (regenerates each session)
.opencode/magic-context/historian/

# IDE
.idea/
.vscode/
*.swp

# Windows
Thumbs.db
Desktop.ini
