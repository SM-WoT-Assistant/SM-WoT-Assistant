@echo off
REM Стартовий скрипт для тестування автооновлення версії

setlocal enabledelayedexpansion

REM Отримуємо поточну директорію скрипту
set SCRIPT_DIR=%~dp0

echo.
echo ╔════════════════════════════════════════════════════════════╗
echo ║         ТЕСТ АВТОМАТИЧНОГО ОНОВЛЕННЯ TTH                  ║
echo ╚════════════════════════════════════════════════════════════╝
echo.

REM Переходимо в папку проекту
cd /d "%SCRIPT_DIR%"

REM Запускаємо Python скрипт тесту
if "%1"=="" (
    echo Запускаю аналіз поточного стану...
    python test_auto_update.py
) else (
    echo Мокую нову версію: %1
    python test_auto_update.py "%1"
)

echo.
echo ╔════════════════════════════════════════════════════════════╗
echo ║ Якщо версія змінена, запустіть main.py:                   ║
echo ║   python main.py                                           ║
echo ║ Автооновлення TTH букде виконано автоматично              ║
echo ╚════════════════════════════════════════════════════════════╝
echo.

pause
