{
  "rules": {
    ".read": false,
    ".write": false,
    "error_reports": {
      ".read": true,
      "$id": {
        ".write": "!data.exists() || auth != null"
      },
      ".indexOn": ["timestamp", "version"]
    },
    "installations": {
      ".read": "auth != null",
      ".write": true,
      ".indexOn": ["last_seen", "version"]
    },
    "service_events": {
      ".read": "auth != null",
      ".write": true,
      ".indexOn": ["timestamp", "category"]
    },
    "schemes": {
      ".read": true,
      ".write": true,
      ".indexOn": ["created_at", "map_id"]
    },
    "versions": {
      ".read": true,
      ".write": "auth != null && auth.uid == 'W0bTk96xJMeVEEbplvMbxtl5igo2'",
      ".indexOn": ["release_date"]
    },
    "groups": {
      ".read": true,
      ".write": true,
      ".indexOn": ["invite_code", "created_at"]
    },
    "user_groups": {
      ".read": true,
      ".write": true,
      ".indexOn": [""]
    },
    "users": {
      ".read": true,
      ".write": true,
      ".indexOn": ["nickname_lower"]
    },
    "builds": {
      ".read": true,
      ".write": "auth != null && auth.uid == 'W0bTk96xJMeVEEbplvMbxtl5igo2'"
    },
    "prompts": {
      ".read": true,
      ".write": "auth != null && auth.uid == 'W0bTk96xJMeVEEbplvMbxtl5igo2'"
    },
    "popular_tanks": {
      ".read": true,
      ".write": "auth != null && auth.uid == 'W0bTk96xJMeVEEbplvMbxtl5igo2'"
    },
    "pending_updates": {
      ".read": true,
      ".write": true
    },
    "admin_app": {
      ".read": "auth != null",
      ".write": "auth != null"
    },
    "drawings": {
      ".read": true,
      ".write": false
    }
  }
}
