{
  "rules": {
    ".read": true,
    ".write": true,
    "error_reports": {
      ".indexOn": ["timestamp", "version"]
    },
    "installations": {
      ".indexOn": ["last_seen", "version"]
    },
    "service_events": {
      ".indexOn": ["timestamp", "category"]
    },
    "schemes": {
      ".indexOn": ["created_at", "map_id"]
    },
    "versions": {
      ".indexOn": ["release_date"]
    },
    "groups": {
      ".indexOn": ["invite_code", "created_at"]
    },
    "user_groups": {
      ".indexOn": [""]
    },
    "users": {
      ".indexOn": ["nickname_lower"]
    }
  }
}
